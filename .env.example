# MongoDB Atlas connection string (Singapore or Mumbai region)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/frenvix?retryWrites=true&w=majority

# Gmail sender (use an App Password, not your normal password)
SMTP_USER=yourstore@gmail.com
SMTP_PASS=your-gmail-app-password

# Where new-order alerts go (defaults to SMTP_USER)
ADMIN_EMAIL=yourstore@gmail.com

# Public site address, used for links inside emails (use your real domain after deploy)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin panel: long random text (generate with the command in the guide)
AUTH_SECRET=

# Cloudinary (product image upload): Dashboard > Settings > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: send order emails from your own domain (cPanel email) instead of Gmail
# SMTP_HOST=mail.yourdomain.com
# SMTP_PORT=465
